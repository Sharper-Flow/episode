# episode configuration (copy to .env and adjust).
#
# Invalid values fail at startup with the offending variable name and expected
# format, except EPISODE_LOG_LEVEL: invalid, empty, and absent values default to
# INFO so logging configuration cannot prevent startup.

# Postgres + pgvector connection (see docker-compose.yml). Required.
EPISODE_DATABASE_URL=postgres://episode:episode@localhost:5434/episode

# Connection pool size (non-zero positive integer). ~8-12 comfortably serves 20
# concurrent agent sessions (recall is a sub-ms HNSW query; sessions are bursty,
# not steady). Default: 10.
EPISODE_DB_POOL_SIZE=10

# Seconds between ADV wisdom/reflection reconcile passes (non-zero positive
# integer). Default: 60.
EPISODE_INGEST_INTERVAL_SECS=60

# Embedding backend. Only "local" (fastembed, BGE) is supported in v0. "voyage"
# and any other value are rejected at startup. Default: local.
EPISODE_EMBED_BACKEND=local

# Reserved for a future embedding tier. Unused while EPISODE_EMBED_BACKEND=local
# (the only supported backend in v0).
# VOYAGE_API_KEY=

# Project roots to ingest ADV wisdom/reflections from, as comma-separated
# namespace=path pairs. Each entry must be a non-empty namespace=path; malformed
# or empty entries (e.g. a trailing comma) are rejected at startup.
# episode reads {path}/.adv/wisdom.jsonl and {path}/.adv/reflections.jsonl.
EPISODE_PROJECT_ROOTS=advance=/home/jon/dev/advance,pokeedge=/home/jon/dev/pokeedge,pokeedge-web=/home/jon/dev/pokeedge-web

# Logging. episode writes logs to stderr (stdout is reserved for MCP JSON-RPC).
# EPISODE_LOG_LEVEL accepts trace/debug/info/warn/error (case-insensitive).
# Absent, empty, or invalid values deterministically default to INFO.
EPISODE_LOG_LEVEL=info
