# episode configuration (copy to .env and adjust).

# Postgres + pgvector connection (see docker-compose.yml).
EPISODE_DATABASE_URL=postgres://episode:episode@localhost:5434/episode

# Connection pool size. ~8-12 comfortably serves 20 concurrent agent sessions
# (recall is a sub-ms HNSW query; sessions are bursty, not steady).
EPISODE_DB_POOL_SIZE=10

# Embedding backend: "local" (fastembed, default) or "voyage".
EPISODE_EMBED_BACKEND=local

# Only required when EPISODE_EMBED_BACKEND=voyage. voyage-4-lite @ 1024 dims.
# VOYAGE_API_KEY=

# Project roots to ingest ADV wisdom/reflections from, as namespace=path pairs.
# episode reads {path}/.adv/wisdom.jsonl and {path}/.adv/reflections.jsonl.
EPISODE_PROJECT_ROOTS=advance=/home/jon/dev/advance,pokeedge=/home/jon/dev/pokeedge,pokeedge-web=/home/jon/dev/pokeedge-web

# Log level (tracing-subscriber env filter).
RUST_LOG=episode=info
